# Server
PORT=5000

# PostgreSQL connection string from Neon
DATABASE_URL=

# JWT signing secret — long random string (min 32 characters recommended)
JWT_SECRET=

# JWT expiry (e.g. 1d, 7d, 12h)
JWT_EXPIRES_IN=1d

# First admin account (used by Prisma seed)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Allowed frontend origin for CORS (local: http://localhost:5173, prod: your Vercel URL)
CLIENT_URL=http://localhost:5173

# development | production
NODE_ENV=development
