# Server
PORT=5000

# PostgreSQL connection string from Neon (added in Milestone 2)
DATABASE_URL=

# JWT signing secret — use a long random string in production
JWT_SECRET=

# JWT expiry (e.g. 1d, 7d, 12h)
JWT_EXPIRES_IN=1d

# First admin account (used by Prisma seed in Milestone 2)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Allowed frontend origin for CORS (e.g. http://localhost:5173)
CLIENT_URL=http://localhost:5173
